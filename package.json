{
  "name": "vite-plugin-sveltekit-ws",
  "version": "2.1.2",
  "description": "Vite plugin to add WebSocket support to SvelteKit using adapter-node",
  "keywords": [
    "adapter-node",
    "sveltekit",
    "vite",
    "websocket",
    "ws"
  ],
  "license": "MIT",
  "author": "n0tz3r0",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.0",
    "vite": "^8.3.1",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.0",
    "vite": "^8.0.0",
    "ws": "^8.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "ignore"
    }
  },
  "packageManager": "pnpm@12.8.1"
}
